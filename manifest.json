{
  "manifest_version": 3,
  "name": "IISM Autofil | Durvesh Developments",
  "version": "0.1.0",
  "description": "Fill the IISM admission form from a profile stored on this device.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://admission.iismgulmarg.in/*"
  ],
  "action": {
    "default_title": "Open IISM Autofil | Durvesh Developments",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admission.iismgulmarg.in/admission_form.aspx*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
